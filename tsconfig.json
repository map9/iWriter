{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "shared/**/*.ts",
    "electron/ai/ipc/protocol.ts"
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./shared/*"],
      "turndown": ["./node_modules/@types/turndown/index.d.ts"],
      "turndown-plugin-gfm": ["./src/types/@guyplusplus/turndown-plugin-gfm.d.ts"]
    }
  }
}
