{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/**/*",
    "src/**/*.vue"
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "turndown": ["node_modules/@types/turndown/index.d.ts"],
      "turndown-plugin-gfm": ["./src/types/@guyplusplus/turndown-plugin-gfm.d.ts"]
    }
  }
}