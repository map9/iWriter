{
  "name": "iwriter",
  "version": "1.0.0",
  "description": "A modern Markdown editor built with Electron, Vue 3, and TypeScript",
  "main": "dist-electron/main.js",
  "homepage": "https://github.com/iwriter/iwriter",
  "author": {
    "name": "iWriter Team",
    "email": "info@iwriter.com"
  },
  "scripts": {
    "dev": "vite",
    "check-deps": "node scripts/check-dependencies.mjs",
    "prebuild": "node scripts/generate-icons.mjs && node scripts/prepare-build.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "build:quick": "vite build",
    "dist": "npm run build && electron-builder",
    "dist:quick": "npm run build:quick && electron-builder",
    "dist:mac": "npm run build:quick && electron-builder --mac",
    "dist:win": "npm run build:quick && electron-builder --win",
    "dist:linux": "npm run build:quick && electron-builder --linux",
    "dist:all": "npm run build:quick && electron-builder --mac --win --linux",
    "publish": "npm run build:quick && cross-env GH_TOKEN=$GH_TOKEN electron-builder --publish always",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "type-check": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/object-hash": "^3.0.6",
    "@types/path-browserify": "^1.0.3",
    "@types/turndown": "^5.0.5",
    "@types/typo-js": "^1.2.2",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.2",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "^10.4.0",
    "favicons": "^7.2.0",
    "npm-check-updates": "^18.1.0",
    "postcss": "^8.5.6",
    "sass": "^1.92.1",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vue-tsc": "^3.0.6",
    "wait-on": "^8.0.4"
  },
  "dependencies": {
    "@guyplusplus/turndown-plugin-gfm": "^1.0.7",
    "@tabler/icons-vue": "^3.34.1",
    "@tiptap/extension-blockquote": "^3.4.1",
    "@tiptap/extension-bold": "^3.4.1",
    "@tiptap/extension-code": "^3.4.1",
    "@tiptap/extension-code-block-lowlight": "^3.4.1",
    "@tiptap/extension-document": "^3.4.1",
    "@tiptap/extension-drag-handle": "^3.4.1",
    "@tiptap/extension-drag-handle-vue-3": "^3.4.1",
    "@tiptap/extension-emoji": "^3.4.1",
    "@tiptap/extension-file-handler": "^3.4.1",
    "@tiptap/extension-hard-break": "^3.4.1",
    "@tiptap/extension-heading": "^3.4.1",
    "@tiptap/extension-highlight": "^3.4.1",
    "@tiptap/extension-horizontal-rule": "^3.4.1",
    "@tiptap/extension-image": "^3.4.1",
    "@tiptap/extension-invisible-characters": "^3.4.1",
    "@tiptap/extension-italic": "^3.4.1",
    "@tiptap/extension-link": "^3.4.1",
    "@tiptap/extension-list": "^3.4.1",
    "@tiptap/extension-mathematics": "^3.4.1",
    "@tiptap/extension-paragraph": "^3.4.1",
    "@tiptap/extension-strike": "^3.4.1",
    "@tiptap/extension-subscript": "^3.4.1",
    "@tiptap/extension-superscript": "^3.4.1",
    "@tiptap/extension-table": "^3.4.1",
    "@tiptap/extension-table-of-contents": "^3.4.1",
    "@tiptap/extension-text": "^3.4.1",
    "@tiptap/extension-text-align": "^3.4.1",
    "@tiptap/extension-text-style": "^3.4.1",
    "@tiptap/extension-typography": "^3.4.1",
    "@tiptap/extension-underline": "^3.4.1",
    "@tiptap/extension-youtube": "^3.4.1",
    "@tiptap/extensions": "^3.4.1",
    "@tiptap/pm": "^3.4.1",
    "@tiptap/static-renderer": "^3.4.1",
    "@tiptap/vue-3": "^3.4.1",
    "canvas": "^3.2.0",
    "chokidar": "^4.0.3",
    "electron-log": "^5.4.3",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.6.2",
    "html2canvas": "^1.4.1",
    "katex": "^0.16.22",
    "lowlight": "^3.3.0",
    "marked": "^16.2.1",
    "object-hash": "^3.0.0",
    "pdfjs-dist": "^5.4.149",
    "pinia": "^3.0.3",
    "prettier": "^3.6.2",
    "turndown": "^7.2.1",
    "typo-js": "^1.2.1",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1",
    "workerpool": "^9.3.4"
  },
  "build": {
    "appId": "com.iwriter.app",
    "productName": "iWriter",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "map9",
        "repo": "iWriter"
      }
    ],
    "mac": {
      "icon": "assets/icons/mac/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icons/win/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icons/linux",
      "category": "Office",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
