{
  "name": "iwriter",
  "version": "0.1.23",
  "description": "A modern Markdown editor built with Electron, Vue 3, and TypeScript",
  "main": "dist-electron/main.js",
  "homepage": "https://github.com/iwriter/iwriter",
  "author": {
    "name": "iWriter Team",
    "email": "info@iwriter.com"
  },
  "scripts": {
    "dev": "vite",
    "check-deps": "node scripts/check-dependencies.mjs",
    "preversion": "node scripts/verify-release-readiness.mjs",
    "postinstall": "patch-package && electron-rebuild -f -w better-sqlite3",
    "rebuild-native": "electron-rebuild -f -w better-sqlite3",
    "docs:sync-version": "node scripts/sync-docs-version.mjs",
    "clean:build": "node -e \"const fs=require('fs'); for (const dir of ['dist','dist-electron']) fs.rmSync(dir,{recursive:true,force:true})\"",
    "prebuild": "node scripts/generate-icons.mjs && node scripts/prepare-build.mjs",
    "build": "npm run type-check && npm run clean:build && vite build",
    "build:quick": "npm run clean:build && vite build",
    "dist": "npm run build && electron-builder",
    "dist:quick": "npm run build:quick && electron-builder",
    "dist:mac": "npm run build:quick && electron-builder --mac",
    "dist:win": "npm run build:quick && electron-builder --win",
    "dist:linux": "npm run build:quick && electron-builder --linux",
    "dist:all": "npm run build:quick && electron-builder --mac --win --linux",
    "publish": "npm run build:quick && cross-env GH_TOKEN=$GH_TOKEN electron-builder --publish always",
    "docs:optimize-images": "node scripts/optimize-docs-images.mjs",
    "docs:dev": "vitepress dev docs",
    "predocs:build": "node scripts/optimize-docs-images.mjs",
    "docs:build": "cross-env BASE_PATH=/iWriter/ vitepress build docs",
    "docs:preview": "cross-env BASE_PATH=/iWriter/ vitepress preview docs",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "type-check": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.electron.json",
    "verify:langchain-patches": "node scripts/verify-langchain-patches.mjs",
    "version": "node scripts/sync-docs-version.mjs --finalize-release && git add package.json package-lock.json docs"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@guyplusplus/turndown-plugin-gfm": "^1.0.7",
    "@tabler/icons-vue": "^3.41.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tiptap/extension-blockquote": "^3.24.0",
    "@tiptap/extension-bold": "^3.24.0",
    "@tiptap/extension-code": "^3.24.0",
    "@tiptap/extension-code-block-lowlight": "^3.24.0",
    "@tiptap/extension-document": "^3.24.0",
    "@tiptap/extension-drag-handle": "^3.24.0",
    "@tiptap/extension-drag-handle-vue-3": "^3.24.0",
    "@tiptap/extension-emoji": "^3.24.0",
    "@tiptap/extension-file-handler": "^3.24.0",
    "@tiptap/extension-hard-break": "^3.24.0",
    "@tiptap/extension-heading": "^3.24.0",
    "@tiptap/extension-highlight": "^3.24.0",
    "@tiptap/extension-horizontal-rule": "^3.24.0",
    "@tiptap/extension-image": "^3.24.0",
    "@tiptap/extension-invisible-characters": "^3.24.0",
    "@tiptap/extension-italic": "^3.24.0",
    "@tiptap/extension-link": "^3.24.0",
    "@tiptap/extension-list": "^3.24.0",
    "@tiptap/extension-mathematics": "^3.24.0",
    "@tiptap/extension-paragraph": "^3.24.0",
    "@tiptap/extension-strike": "^3.24.0",
    "@tiptap/extension-subscript": "^3.24.0",
    "@tiptap/extension-superscript": "^3.24.0",
    "@tiptap/extension-table": "^3.24.0",
    "@tiptap/extension-table-of-contents": "^3.24.0",
    "@tiptap/extension-text": "^3.24.0",
    "@tiptap/extension-text-align": "^3.24.0",
    "@tiptap/extension-text-style": "^3.24.0",
    "@tiptap/extension-typography": "^3.24.0",
    "@tiptap/extension-underline": "^3.24.0",
    "@tiptap/extension-unique-id": "^3.24.0",
    "@tiptap/extension-youtube": "^3.24.0",
    "@tiptap/extensions": "^3.24.0",
    "@tiptap/pm": "^3.24.0",
    "@tiptap/static-renderer": "^3.24.0",
    "@tiptap/suggestion": "^3.24.0",
    "@tiptap/vue-3": "^3.24.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^7.0.2",
    "@types/jsdom": "^28.0.3",
    "@types/lodash": "^4.17.20",
    "@types/object-hash": "^3.0.6",
    "@types/turndown": "^5.0.6",
    "@types/typo-js": "^1.2.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "canvas": "^3.2.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "daisyui": "^5.5.19",
    "diff": "^9.0.0",
    "dotenv": "^17.2.2",
    "electron": "^40.8.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "^10.4.0",
    "favicons": "^7.2.0",
    "html2canvas": "^1.4.1",
    "imagesloaded": "^5.0.0",
    "katex": "^0.16.46",
    "lowlight": "^3.3.0",
    "marked": "^18.0.3",
    "nanoid": "^5.1.6",
    "npm-check-updates": "^18.1.0",
    "object-hash": "^3.0.0",
    "packery": "^3.0.0",
    "pagedjs": "^0.4.3",
    "patch-package": "^8.0.1",
    "pdfjs-dist": "^5.7.284",
    "pinia": "^3.0.4",
    "prettier": "^3.6.2",
    "sass": "^1.92.1",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.2",
    "typo-js": "^1.3.2",
    "vite": "^7.1.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitepress": "^2.0.0-alpha.17",
    "vue": "^3.5.21",
    "vue-i18n": "^11.3.2",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.0.6",
    "wait-on": "^8.0.4",
    "workerpool": "^10.0.2"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.4.0",
    "@langchain/core": "^1.1.48",
    "@langchain/google-genai": "^2.1.31",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.1",
    "@langchain/openai": "^1.4.7",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^12.8.0",
    "chokidar": "^5.0.0",
    "deepagents": "1.10.2",
    "electron-log": "^5.4.3",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.6.2",
    "jsdom": "^29.1.1",
    "mermaid": "^11.15.0",
    "turndown": "^7.2.4"
  },
  "build": {
    "appId": "com.iwriter.app",
    "productName": "iWriter",
    "afterSign": "scripts/notarize.cjs",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "electron/ai/builtin-skills",
        "to": "builtin-skills",
        "filter": [
          "**/*.md",
          "!**/.DS_Store"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!**/*.map",
      "!**/*.{ts,tsx,mts,cts}",
      "!**/.DS_Store",
      "!**/{test,tests,__tests__,example,examples,benchmark,benchmarks}/**",
      "!**/{README.md,readme.md,CHANGELOG.md,changelog.md,HISTORY.md,history.md,CONTRIBUTING.md,contributing.md,SECURITY.md,security.md}",
      "!dist/dictionaries/**/{readme.md,README.md,package.json}"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "map9",
        "repo": "iWriter"
      }
    ],
    "extraMetadata": {
      "napi": {
        "targets": [
          "x86_64-apple-darwin",
          "aarch64-apple-darwin",
          "x86_64-pc-windows-msvc",
          "aarch64-pc-windows-msvc",
          "x86_64-unknown-linux-gnu",
          "aarch64-unknown-linux-gnu"
        ]
      }
    },
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "icon": "icons/mac/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.plist",
      "entitlementsInherit": "entitlements.plist",
      "identity": "yafu Sun (HAZ5NVW387)"
    },
    "win": {
      "icon": "icons/win/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "icons/linux",
      "category": "Office",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
